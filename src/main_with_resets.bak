#include <Arduino.h>

#include "inc/astro_point.h"
#include "inc/bno085.h"
#include "inc/io.h"

#define BNO08X_RESET -1
BNO085 imu;

static astro_observer_t observer;
static astro_time_t obsTime;

static uint32_t resetCount = 0;
static uint32_t lastResetMs = 0;

void setup(void) {
  setupSerial();
  imu.setupBNO085();

  observer.height = 0.0;
  observer.latitude = 41.458074;
  observer.longitude = -81.927939;

  obsTime = Astronomy_MakeTime(2026, 7, 16, 9, 2, 00.0);
}

void loop() {
  if (imu.wasReset()) {
    /* Ask the hub why it restarted before re-enabling reports. A steady reset
     * interval points at overload/watchdog; a scattered one at power. */
    uint8_t cause = imu.readResetCause();
    uint32_t nowMs = millis();

    resetCount++;
    Serial.printf("[reset #%lu] t=%lums  uptime=%lums  cause=%u (%s)\r\n", resetCount, nowMs,
                  resetCount == 1 ? nowMs : nowMs - lastResetMs, cause, BNO085::resetCauseName(cause));
    lastResetMs = nowMs;

    imu.setupBNO085(true);
  }

  bool fresh = imu.checkSensor();

  const double boresight[3] = {-1.0, 0.0, 0.0}; /* body -X forward */
  double ned[3], az, alt;

  rotate_vector(imu.ypr.roll, imu.ypr.pitch, imu.ypr.yaw, boresight, ned);
  enu_to_azalt(ned, -8.5, &az, &alt);

  /* Reports arrive far slower than the loop spins, so count them across the
   * whole print interval rather than testing a single iteration. Zero reports
   * means the readings below are stale; the count also shows whether the
   * configured rate is actually being achieved. */
  static uint32_t reportsSincePrint = 0;
  if (fresh) reportsSincePrint++;

  static uint32_t last = 0;
  uint32_t now = millis();

  if (now - last >= 250) {
    Serial.print(imu.sensorValue.status);  // This is accuracy in the range of 0 to 3
    Serial.print("\t");
    // Serial.printf("RA = %.4f h   Dec = %+.4f deg\r\n", eq.ra, eq.dec);
    Serial.printf("ALT = %+.4f deg  AZ = %+.4f deg  rpts=%lu%s\r\n", alt, az, reportsSincePrint,
                  reportsSincePrint == 0 ? "  [stale]" : "");
    reportsSincePrint = 0;
    last = now;
  }
}
